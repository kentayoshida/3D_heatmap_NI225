# Cloudflare Pages headers. Live market data comes from the Worker API, so keep
# the app shell/code always-fresh (revalidate) and cache only the vendored libs.
/index.html
  Cache-Control: no-cache
/js/*
  Cache-Control: no-cache
/css/*
  Cache-Control: no-cache
/data/*
  Cache-Control: no-cache
/lib/*
  Cache-Control: public, max-age=604800
